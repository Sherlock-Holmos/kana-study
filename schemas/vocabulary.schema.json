{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Japanese Study Vocabulary Item",
  "type": "object",
  "required": ["id", "type", "expression", "reading", "meanings", "partOfSpeech", "level", "tags"],
  "properties": {
    "id": { "type": "string", "pattern": "^vocab:" },
    "type": { "const": "vocabulary" },
    "expression": { "type": "string", "minLength": 1 },
    "reading": { "type": "string", "minLength": 1 },
    "meanings": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "partOfSpeech": { "type": "string" },
    "level": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
